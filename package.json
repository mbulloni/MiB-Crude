{
  "name": "mib-crude",
  "version": "0.5.0",
  "description": "MiB-Crude - generatore visuale di applicazioni web PHP per Linux, ispirato a generatori classici, multisviluppatore",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5175 && cross-env VITE_DEV=1 electron . --no-sandbox\"",
    "build": "vite build",
    "start": "vite build && electron . --no-sandbox",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "server": "node server/mibcrude-server.cjs",
    "dist": "vite build && electron-builder --linux AppImage deb",
    "dist:deb": "vite build && electron-builder --linux deb",
    "test:db": "for db in mysql pgsql sqlite sqlsrv oracle; do echo \"== $db\"; MIBCRUDE_TEST_DB=$db node --test tests/e2e.test.cjs || exit 1; done"
  },
  "author": {
    "name": "Michele",
    "email": "m.bulloni@gmail.com"
  },
  "license": "MIT",
  "build": {
    "appId": "it.michele.mibcrude",
    "productName": "MiB-Crude",
    "files": [
      "dist/**",
      "electron/**",
      "core/**",
      "runtime/**",
      "server/**",
      "package.json"
    ],
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "mib-crude",
      "synopsis": "Generatore di applicazioni web PHP",
      "maintainer": "Michele <m.bulloni@gmail.com>",
      "vendor": "Michele",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "StartupWMClass": "mib-crude",
          "Keywords": "php;crud;generator;phpr;database;",
          "GenericName": "Generatore app PHP"
        }
      },
      "description": "Generatore visuale di applicazioni web PHP ispirato a generatori classici, multisviluppatore (Git e server del team)."
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "xdg-utils"
      ],
      "recommends": [
        "php-cli",
        "git"
      ],
      "packageCategory": "devel",
      "priority": "optional"
    },
    "asarUnpack": [
      "electron/docker/**",
      "electron/docker-oci/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "basic-ftp": "^6.2.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.1",
    "datatables.net-bs5": "^2.3.8",
    "datatables.net-buttons-bs5": "^3.2.6",
    "datatables.net-responsive-bs5": "^3.0.8",
    "echarts": "^5.6.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "fullcalendar": "^6.1.22",
    "jquery": "^3.7.1",
    "leaflet": "1.9",
    "mariadb": "^3.5.4",
    "mssql": "^12.7.13",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^1.5.2",
    "sql.js": "^1.15.2",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.16"
  },
  "desktopName": "mib-crude.desktop",
  "homepage": "https://github.com/mbulloni/MiB-Crude"
}
